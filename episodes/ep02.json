    },
    {
      "t0": 66.0,
      "t1": 71.5,
      "text": "He called it Pixel."
    },
    {
      "t0": 73.0,
      "t1": 79.6,
      "text": "Something was\nunder the lake."
    },
    {
      "t0": 81.0,
      "t1": 86.0,
      "text": "He wasn't alone\non this planet."
    },
    {
      "t0": 86.5,
