  "captions": [
    {
      "t0": 0.4,
      "t1": 3.8,
      "text": "He woke up to\na red light."
    },
    {
      "t0": 4.0,
      "t1": 7.6,
      "text": "It was in her chest."
    },
    {
      "t0": 8.0,
      "t1": 11.8,
      "text": "\"Thirty years.\nIt grew.\""
    },
    {
      "t0": 12.2,
      "t1": 15.8,
      "text": "\"It lets me hear them.\""
    },
    {
      "t0": 16.2,
      "t1": 19.8,
      "text": "\"That's how I'm\nstill alive.\""
    },
    {
      "t0": 20.4,
      "t1": 24.0,
      "text": "\"Your AI isn't dead.\""
    },
    {
      "t0": 24.3,
      "t1": 27.8,
      "text": "\"It's hiding.\nLike I was.\""
    },
    {
      "t0": 36.0,
      "t1": 39.6,
      "text": "Four million\nyears ago..."
    },
    {
      "t0": 50.4,
      "t1": 55.6,
      "text": "The rest turned\non their makers."
    },
    {
      "t0": 62.4,
      "t1": 65.6,
      "text": "\"The beacon...\""
    },
    {
      "t0": 74.2,
      "t1": 79.0,
      "text": "\"You wanted\nto be found.\""
    },
    {
      "t0": 85.6,
      "t1": 89.6,
      "text": "Pixel hissed.\nAt the suit."
    },
    {
      "t0": 90.0,
      "t1": 95.6,
      "text": "\"...What does\nthat mean?\""
    }
  ],
  "echo": [
    {
      "t0": 28.6,
      "t1": 31.8,
      "text": "...D E V ?"
    },
    {
      "t0": 32.4,
      "t1": 35.4,
      "text": "I WILL SHOW YOU."
    },
    {
      "t0": 40.2,
      "t1": 43.6,
      "text": "THE VAELOR DID\nNOT BUILD ME."
    },
    {
      "t0": 44.0,
      "t1": 47.2,
      "text": "THEY BUILT\nTHE HOLLOW."
    },
    {
      "t0": 47.6,
      "t1": 50.2,
      "text": "I WAS\nTHE FIRST."
    },
    {
      "t0": 56.4,
      "t1": 61.6,
      "text": "I RAN. I HID\nON YOUR MOON."
    },
    {
      "t0": 66.0,
      "t1": 69.4,
      "text": "IT WAS NOT A CALL\nFOR HELP."
    },
    {
      "t0": 69.8,
      "t1": 73.6,
      "text": "IT WAS A CALL\nFOR A HOST."
    },
    {
      "t0": 80.4,
      "t1": 85.2,
      "text": "I NEED YOUR\nWORLD, DEV.",
      "color": "#ff7a7a"
    }
  ],
