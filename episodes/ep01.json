  "captions": [
    { "t0": 0.4,  "t1": 5.0,  "text": "3 days ago, the Moon started\nsending a signal." },
    { "t0": 5.3,  "t1": 10.4, "text": "NASA sent one man to find it.\nCommander Dev Rao." },
    { "t0": 10.8, "t1": 13.6, "text": "It wasn't a satellite." },
    { "t0": 13.8, "t1": 17.0, "text": "It was a ship.\nCrashed 4 million years ago." },
    { "t0": 17.3, "t1": 20.6, "text": "The signal came from inside." },
    { "t0": 20.8, "t1": 24.0, "text": "...and it was getting stronger." },
    { "t0": 24.3, "t1": 26.6, "text": "He touched one panel." },
    { "t0": 26.9, "t1": 29.4, "text": "Big mistake." },
    { "t0": 33.0, "t1": 36.8, "text": "He woke up on the other side\nof the universe." },
    { "t0": 37.0, "t1": 40.6, "text": "Earth was 2 billion\nlight-years away." },
    { "t0": 40.8, "t1": 44.0, "text": "Now he has to find\nthe way home." }
  ],
