  "captions": [
    { "t0": 0.6, "t1": 4.4, "text": "Ten thousand\nscratches." },
    { "t0": 4.8, "t1": 8.8, "text": "One for every day\nshe'd been here." },
    { "t0": 9.6, "t1": 13.4, "text": "\"Mira Sen.\nKestrel-4.\"" },
    { "t0": 13.8, "t1": 17.4, "text": "\"Launched 1996.\nNever came home.\"" },
    { "t0": 17.8, "t1": 20.6, "text": "Pixel didn't\nlike her." },
    { "t0": 21.4, "t1": 25.6, "text": "\"We found a ring\nout past Jupiter.\"" },
    { "t0": 27.0, "t1": 31.0, "text": "\"It found us\nback.\"" },
    { "t0": 34.4, "t1": 38.2, "text": "\"I stole this\nthe day I ran.\"" },
    { "t0": 40.6, "t1": 44.0, "text": "The fourth key." },
    { "t0": 48.8, "t1": 52.2, "text": "\"There's a way out.\"" },
    { "t0": 52.8, "t1": 56.6, "text": "\"Through\nthe nest.\"" },
    { "t0": 58.8, "t1": 62.2, "text": "\"Stay here.\nDon't move.\"" },
    { "t0": 66.2, "t1": 69.8, "text": "It looked right\nat her..." },
    { "t0": 71.0, "t1": 74.4, "text": "...and walked\naway." },
    { "t0": 80.0, "t1": 83.6, "text": "\"How did it\nnot see you?\"" },
    { "t0": 84.6, "t1": 87.8, "text": "\"Luck.\"" },
    { "t0": 91.4, "t1": 96.8, "text": "Some of her\nwasn't human anymore." }
  ],
